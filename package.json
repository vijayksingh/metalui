{
  "name": "@unlocalhosted/metalui",
  "version": "0.0.0",
  "description": "Soft Hardware components for React (on Base UI) and SwiftUI, with animated duotone icons and agent guides",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "public/AI.md",
    "public/components.json",
    "public/icons.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./dist/index.css",
    "./icons.css": "./dist/icons.css",
    "./components.json": "./public/components.json",
    "./icons.json": "./public/icons.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4193",
    "generate": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs && node scripts/build-registry.mjs && node scripts/build-agent-docs.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/build-icons.mjs --check && node scripts/build-registry.mjs --check && node scripts/build-agent-docs.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.mjs --test tests/*.test.tsx",
    "build:package": "tsup",
    "build:site": "vite build",
    "build": "npm run check && npm run build:package && npm run build:site"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayksingh/metalui.git"
  },
  "homepage": "https://metalui.dev",
  "bugs": {
    "url": "https://github.com/vijayksingh/metalui/issues"
  },
  "keywords": [
    "react",
    "swiftui",
    "base-ui",
    "components",
    "design-system",
    "icons",
    "skeuomorphic"
  ]
}
