{
  "name": "@unlocalhosted/metalui",
  "version": "0.3.3",
  "description": "Soft Hardware components for React (on Base UI) and SwiftUI, with animated duotone icons and agent guides",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/components/tokens.css",
    "src/components/theme.css",
    "public/AI.md",
    "public/components.json",
    "public/icons.json",
    "public/icons-life.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "icons": [
        "dist/icons.d.ts"
      ],
      "icons/life": [
        "dist/icons-life.d.ts"
      ],
      "sound": [
        "dist/sound.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/life": {
      "types": "./dist/icons-life.d.ts",
      "import": "./dist/icons-life.js"
    },
    "./sound": {
      "types": "./dist/sound.d.ts",
      "import": "./dist/sound.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.unlayered.css": "./dist/styles.unlayered.css",
    "./icons.css": "./dist/icons.css",
    "./icons/life.css": "./dist/icons-life.css",
    "./tokens.css": "./src/components/tokens.css",
    "./theme.css": "./src/components/theme.css",
    "./components.json": "./public/components.json",
    "./icons.json": "./public/icons.json",
    "./icons-life.json": "./public/icons-life.json"
  },
  "scripts": {
    "build": "tsup && rm -rf dist/components && rm -f dist/index.css && tailwindcss -i styles.input.css -o dist/styles.css --minify && node ../../scripts/build-unlayered.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayksingh/metalui.git"
  },
  "homepage": "https://metalui.dev",
  "bugs": {
    "url": "https://github.com/vijayksingh/metalui/issues"
  },
  "keywords": [
    "react",
    "swiftui",
    "base-ui",
    "components",
    "design-system",
    "icons",
    "skeuomorphic"
  ]
}
