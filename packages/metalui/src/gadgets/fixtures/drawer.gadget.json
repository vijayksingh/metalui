{
  "$schema": "metalui/gadget@1",
  "name": "drawer", "title": "Storage",
  "job": "keep", "feel": { "v": 0.6, "a": 0.1, "w": 0.2 }, "container": "slab", "station": 140, "material": "metal",
  "parts": [
    { "id": "body", "part": "slab", "at": [200, 160], "size": [320, 248], "role": "body" },
    { "id": "lamp", "part": "led",  "at": [313, 78],  "role": "lamp" },
    { "id": "tray", "part": "slab", "at": [200, 206], "size": [256, 140], "role": "actor" },
    { "id": "pull", "part": "pull", "at": [200, 311], "role": "actor", "material": "metal", "params": { "style": "bar" } }
  ],
  "mechanism": { "name": "slide-out", "bind": { "tray": "tray", "pull": "pull", "lamp": "lamp" }, "drive": "fill" },
  "ports": { "in": { "fill": { "kind": "number", "min": 0, "max": 1, "default": 0.4 } },
             "out": { "full": { "kind": "boolean" } } },
  "states": {
    "rest": { "lamp": ["off", "steady"] },
    "open": { "lamp": ["live", "steady"], "form": { "tray": { "pose": { "y": 60 } }, "pull": { "pose": { "y": 60 } } } },
    "full": { "lamp": ["waiting", "steady"], "form": { "tray": { "pose": { "y": 22 } }, "pull": { "pose": { "y": 22 } } }, "hint": "too full to close" }
  },
  "describe": "{title}: {share} full"
}
