{
  "$schema": "metalui/gadget@1",
  "name": "fader-bank", "title": "Settings",
  "job": "tune", "reach": "own", "feel": { "v": 0.6, "a": 0.5, "w": 0 }, "container": "slab",
  "parts": [
    { "id": "body", "part": "slab", "at": [200, 196], "size": [320, 320], "role": "body" },
    { "id": "lamp", "part": "led",  "at": [313, 78],  "role": "lamp" },
    { "id": "cap1", "part": "cap",  "at": [128, 210], "role": "actor", "params": { "value": 0.3 } },
    { "id": "cap2", "part": "cap",  "at": [200, 210], "role": "actor", "material": "accent", "params": { "value": 0.72 } },
    { "id": "cap3", "part": "cap",  "at": [272, 210], "role": "actor", "params": { "value": 0.5 } }
  ],
  "mechanism": { "name": "slide", "bind": { "caps": ["cap1", "cap2", "cap3"], "slot": "body", "lamp": "lamp" }, "detents": 8, "drive": "mix" },
  "ports": { "in": { "mix": { "kind": "number", "min": 0, "max": 1, "default": 0.5 } } },
  "states": {
    "rest":    { "lamp": ["off", "steady"] },
    "on":      { "lamp": ["live", "steady"] },
    "changed": { "lamp": ["live", "flicker"], "beep": "done" }
  },
  "initial": "on",
  "describe": "{title}: {state}"
}
