{
  "$schema": "metalui/gadget@1",
  "name": "scope", "title": "Search",
  "job": "find", "reach": "world", "feel": { "v": 0.7, "a": 0.8, "w": 0.1 }, "container": "inset", "material": "stone",
  "parts": [
    { "id": "body", "part": "bezel",      "at": [200, 196], "size": [320, 320], "role": "body", "params": { "opening": "round" } },
    { "id": "face", "part": "glass-face", "at": [200, 196], "size": [276, 276], "role": "trim" },
    { "id": "beam", "part": "backlight",  "at": [200, 196], "size": [276, 276], "role": "actor", "params": { "shape": "beam", "color": "glass" } },
    { "id": "b1",   "part": "backlight",  "at": [150, 146], "size": [20, 20], "role": "actor", "params": { "shape": "dot", "color": "glass" } },
    { "id": "b2",   "part": "backlight",  "at": [266, 230], "size": [20, 20], "role": "actor", "params": { "shape": "dot", "color": "glass" } },
    { "id": "b3",   "part": "backlight",  "at": [176, 278], "size": [20, 20], "role": "actor", "params": { "shape": "dot", "color": "glass" } },
    { "id": "lamp", "part": "led",        "at": [322, 72],  "role": "lamp" }
  ],
  "mechanism": { "name": "sweep", "bind": { "beam": "beam", "face": "face", "blips": ["b1", "b2", "b3"], "lamp": "lamp" } },
  "ports": { "in": { "query": { "kind": "boolean", "default": false } }, "out": { "found": { "kind": "count", "max": 99 } } },
  "states": {
    "rest":      { "lamp": ["off", "steady"] },
    "searching": { "lamp": ["waiting", "breathe"], "enter": "act" },
    "found":     { "lamp": ["live", "steady"], "beep": "done", "form": { "b1": { "param": "alpha", "value": 1 }, "b2": { "param": "alpha", "value": 1 }, "b3": { "param": "alpha", "value": 1 } } },
    "nothing":   { "lamp": ["waiting", "steady"], "beep": "waiting" }
  },
  "initial": "rest",
  "describe": "{title}: {state}"
}
