      "content": "/* Generated by scripts/build-tokens.mjs from tokens/tokens.json. Do not edit. */\n/* Values are the approved Soft Hardware object sheet (Rev B). */\n:root {\n  --mu-page: #F3F3F1;\n  --mu-page-dark: #0E0E0F;\n  --mu-green: #78D6A5;\n  --mu-green-deep: #3FB97A;\n  --mu-orange: #FF6B3D;\n  --mu-blue: #2457F2;\n  --mu-red: #D8453B;\n  --mu-gold: #C7A76B;\n  --mu-led-green: radial-gradient(circle at 40% 35%, #D9FFE9 0 18%, #7BEAAE 42%, #2FB673 100%);\n  --mu-led-red: radial-gradient(circle at 40% 35%, #FFD9D2 0 18%, #FF7A66 45%, #D5392A 100%);\n  --mu-led-amber: radial-gradient(circle at 40% 35%, #FFF1CF 0 18%, #F5BF55 45%, #C98A18 100%);\n  --mu-mono: \"SF Mono\", ui-monospace, \"Menlo\", monospace;\n  --mu-sans: -apple-system, \"SF Pro Text\", \"SF Pro\", system-ui, sans-serif;\n  --mu-ease-press: cubic-bezier(.3,.0,.2,1);\n  --mu-ease-slide: cubic-bezier(.22,.9,.25,1);\n  --mu-focus: #3FB97A;\n  /* k=120 c=13: objects: cards, fan-out, hover lift */\n  --mu-spring-obj: linear(0, 0.0204, 0.0747, 0.1532, 0.2476, 0.3505, 0.4561, 0.5597, 0.6576, 0.7472, 0.8269, 0.8957, 0.9534, 1.0001, 1.0365, 1.0634, 1.0819, 1.093, 1.0981, 1.0982, 1.0944, 1.0877, 1.0791, 1.0693, 1.059, 1.0486, 1.0386, 1.0293, 1.021, 1.0136, 1.0074, 1.0022, 0.9981, 0.995, 0.9927, 0.9913, 0.9905, 0.9903, 0.9905, 0.991, 0.9917, 0.9927, 0.9937, 0.9947, 0.9957, 0.9966, 0.9975, 0.9983, 1);\n  --mu-spring-obj-d: 0.92s;\n  /* k=120 c=14: flap tilt, drawers */\n  --mu-spring-flap: linear(0, 0.0211, 0.0765, 0.1557, 0.2499, 0.3517, 0.4551, 0.5556, 0.6499, 0.7356, 0.8114, 0.8765, 0.931, 0.9751, 1.0097, 1.0356, 1.0538, 1.0655, 1.0717, 1.0735, 1.072, 1.0679, 1.0621, 1.0551, 1.0477, 1.0401, 1.0327, 1.0257, 1.0194, 1.0139, 1.0091, 1.0051, 1.0018, 0.9993, 0.9974, 0.996, 0.9952, 0.9947, 0.9946, 0.9947, 0.995, 0.9954, 0.9959, 0.9965, 0.9971, 0.9976, 0.9981, 0.9986, 1);\n  --mu-spring-flap-d: 0.94s;\n  /* k=170 c=16: controls: thumbs, toggles, ticks */\n  --mu-spring-ui: linear(0, 0.0207, 0.0757, 0.1547, 0.2492, 0.3518, 0.4565, 0.5588, 0.6551, 0.743, 0.8209, 0.888, 0.9441, 0.9895, 1.0249, 1.0512, 1.0694, 1.0806, 1.0861, 1.0869, 1.084, 1.0785, 1.0711, 1.0626, 1.0535, 1.0444, 1.0357, 1.0275, 1.0201, 1.0136, 1.0081, 1.0035, 0.9998, 0.997, 0.995, 0.9936, 0.9928, 0.9924, 0.9925, 0.9928, 0.9934, 0.994, 0.9948, 0.9956, 0.9964, 0.9971, 0.9978, 0.9984, 1);\n  --mu-spring-ui-d: 0.6s;\n  /* k=500 c=40: press release */\n  --mu-spring-press: linear(0, 0.0141, 0.0508, 0.1029, 0.165, 0.2325, 0.3023, 0.3719, 0.4394, 0.5035, 0.5636, 0.6191, 0.6697, 0.7154, 0.7563, 0.7927, 0.8247, 0.8528, 0.8771, 0.8982, 0.9162, 0.9317, 0.9447, 0.9557, 0.9649, 0.9725, 0.9788, 0.984, 0.9882, 0.9915, 0.9942, 0.9963, 0.998, 0.9992, 1);\n  --mu-spring-press-d: 0.3s;\n  --mu-primary-bg: linear-gradient(#38383C,#252528);\n  --mu-primary-sh: inset 0 0 5px 1px rgba(255,255,255,.07), inset 1px 2px 2px -1px rgba(255,255,255,.18), 0 0 0 .5px rgba(0,0,0,.5), 0 1px 2px rgba(0,0,0,.15), 0 5px 12px -4px rgba(0,0,0,.22);\n  --mu-primary-pressed-bg: linear-gradient(#1C1C1E,#242427);\n  --mu-primary-pressed-sh: inset 0 1px 3px rgba(0,0,0,.6), 0 0 0 .5px rgba(0,0,0,.7);\n  --mu-primary-ink: #FFFFFF;\n  --mu-destructive-bg: linear-gradient(#E6594E,#D0433A);\n  --mu-destructive-sh: inset 0 0 6px 1px rgba(255,255,255,.14), inset 1px 2px 2px -1px rgba(255,255,255,.32), 0 0 0 .5px rgba(120,20,10,.3), 0 1px 2px rgba(110,10,0,.14), 0 5px 12px -4px rgba(170,30,20,.24);\n  --mu-destructive-pressed-bg: linear-gradient(#BE352C,#CF4238);\n  --mu-destructive-pressed-sh: inset 0 1px 3px rgba(80,0,0,.45), 0 0 0 .5px rgba(110,10,0,.55);\n  --mu-destructive-ink: #FFFFFF;\n}\n\n:root,\n[data-mu-colorway=\"bone\"] {\n  color-scheme: light;\n  --mu-s-hi: #FCFBF9;\n  --mu-s: #F6F5F2;\n  --mu-s-lo: #F0EFEB;\n  --mu-well-top: #E6E5E1;\n  --mu-well-bot: #ECEBE7;\n  --mu-ink: #1B1B1D;\n  --mu-ink2: #5C5C60;\n  --mu-ink3: #9A9A9D;\n  --mu-icon: #3A3A3D;\n  --mu-engrave: rgba(40,38,32,.46);\n  --mu-lip: rgba(255,255,255,.55);\n  --mu-rule: rgba(0,0,0,.06);\n  --mu-rule-lip: rgba(255,255,255,.5);\n  --mu-thumb-hi: #FFFFFF;\n  --mu-thumb-lo: #F7F6F3;\n  --mu-frost: rgba(250,249,246,.68);\n  --mu-frost-strong: rgba(251,250,248,.80);\n  --mu-raise: inset 0 0 6px 2px rgba(255,255,255,.75), inset 2px 3px 3px -1px rgba(255,255,255,.95), inset -1px -3px 5px -2px rgba(110,100,80,.07), 0 0 0 .5px rgba(24,22,16,.045), 0 1px 2px rgba(24,22,16,.05), 0 8px 18px -6px rgba(24,22,16,.08), 0 26px 50px -16px rgba(24,22,16,.13), 0 52px 96px -36px rgba(24,22,16,.13);\n  --mu-raise-sm: inset 0 0 4px 1px rgba(255,255,255,.85), inset 1px 2px 2px -1px #FFFFFF, 0 0 0 .5px rgba(24,22,16,.05), 0 1px 2px rgba(24,22,16,.07), 0 5px 12px -4px rgba(24,22,16,.09);\n  --mu-well: inset 0 2px 6px -1px rgba(60,55,40,.10), inset 0 0 0 .5px rgba(0,0,0,.03), inset 0 -2px 4px -2px rgba(255,255,255,.95);\n  --mu-cap-bg: linear-gradient(#FFFFFF,#F5F4F1);\n  --mu-cap-sh: inset 0 0 3px 1px rgba(255,255,255,.9), 0 0 0 .5px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.07);\n  --mu-btn-bg: linear-gradient(#FFFFFF,#F4F3F0);\n  --mu-btn-sh: inset 0 0 4px 1px rgba(255,255,255,.9), inset 1px 2px 2px -1px #FFFFFF, 0 0 0 .5px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.06), 0 4px 9px -3px rgba(0,0,0,.08);\n  --mu-pressed-bg: linear-gradient(#E9E8E4,#EFEEEA);\n  --mu-pressed-sh: inset 0 2px 5px -1px rgba(60,55,40,.14), inset 0 0 0 .5px rgba(0,0,0,.035), inset 0 -2px 3px -2px rgba(255,255,255,.9);\n  --mu-duo-k: 1;\n}\n\n[data-mu-colorway=\"graphite\"] {\n  color-scheme: dark;\n  --mu-s-hi: #2C2C2F;\n  --mu-s: #252527;\n  --mu-s-lo: #202022;\n  --mu-well-top: #141415;\n  --mu-well-bot: #18181A;\n  --mu-ink: #F2F2F0;\n  --mu-ink2: #A6A6A9;\n  --mu-ink3: #6E6E72;\n  --mu-icon: #D6D6D8;\n  --mu-engrave: rgba(255,255,255,.34);\n  --mu-lip: rgba(0,0,0,.35);\n  --mu-rule: rgba(0,0,0,.45);\n  --mu-rule-lip: rgba(255,255,255,.035);\n  --mu-thumb-hi: #3A3A3D;\n  --mu-thumb-lo: #2E2E31;\n  --mu-frost: rgba(36,36,39,.66);\n  --mu-frost-strong: rgba(34,34,37,.78);\n  --mu-raise: inset 0 0 6px 2px rgba(255,255,255,.055), inset 1.5px 2.5px 3px -1px rgba(255,255,255,.10), inset -1px -3px 5px -2px rgba(0,0,0,.35), 0 0 0 .5px rgba(0,0,0,.45), 0 1px 2px rgba(0,0,0,.22), 0 8px 18px -6px rgba(0,0,0,.2), 0 26px 50px -16px rgba(0,0,0,.34), 0 52px 96px -36px rgba(0,0,0,.3);\n  --mu-raise-sm: inset 0 0 4px 1px rgba(255,255,255,.06), inset 1px 2px 2px -1px rgba(255,255,255,.12), 0 0 0 .5px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.3), 0 5px 12px -4px rgba(0,0,0,.3);\n  --mu-well: inset 0 2px 6px -1px rgba(0,0,0,.6), inset 0 0 0 .5px rgba(0,0,0,.35), inset 0 -2px 4px -2px rgba(255,255,255,.05);\n  --mu-cap-bg: linear-gradient(#35353A,#2A2A2D);\n  --mu-cap-sh: inset 0 0 3px 1px rgba(255,255,255,.06), 0 0 0 .5px rgba(0,0,0,.6), 0 1px 2px rgba(0,0,0,.3);\n  --mu-btn-bg: linear-gradient(#313134,#28282B);\n  --mu-btn-sh: inset 0 0 4px 1px rgba(255,255,255,.05), inset 1px 2px 2px -1px rgba(255,255,255,.10), 0 0 0 .5px rgba(0,0,0,.6), 0 1px 2px rgba(0,0,0,.3), 0 4px 9px -3px rgba(0,0,0,.3);\n  --mu-pressed-bg: linear-gradient(#18181A,#1C1C1E);\n  --mu-pressed-sh: inset 0 2px 5px -1px rgba(0,0,0,.65), inset 0 0 0 .5px rgba(0,0,0,.5), inset 0 -2px 3px -2px rgba(255,255,255,.05);\n  --mu-duo-k: 1.3;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-mu-colorway=\"bone\"]) {\n    color-scheme: dark;\n    --mu-s-hi: #2C2C2F;\n    --mu-s: #252527;\n    --mu-s-lo: #202022;\n    --mu-well-top: #141415;\n    --mu-well-bot: #18181A;\n    --mu-ink: #F2F2F0;\n    --mu-ink2: #A6A6A9;\n    --mu-ink3: #6E6E72;\n    --mu-icon: #D6D6D8;\n    --mu-engrave: rgba(255,255,255,.34);\n    --mu-lip: rgba(0,0,0,.35);\n    --mu-rule: rgba(0,0,0,.45);\n    --mu-rule-lip: rgba(255,255,255,.035);\n    --mu-thumb-hi: #3A3A3D;\n    --mu-thumb-lo: #2E2E31;\n    --mu-frost: rgba(36,36,39,.66);\n    --mu-frost-strong: rgba(34,34,37,.78);\n    --mu-raise: inset 0 0 6px 2px rgba(255,255,255,.055), inset 1.5px 2.5px 3px -1px rgba(255,255,255,.10), inset -1px -3px 5px -2px rgba(0,0,0,.35), 0 0 0 .5px rgba(0,0,0,.45), 0 1px 2px rgba(0,0,0,.22), 0 8px 18px -6px rgba(0,0,0,.2), 0 26px 50px -16px rgba(0,0,0,.34), 0 52px 96px -36px rgba(0,0,0,.3);\n    --mu-raise-sm: inset 0 0 4px 1px rgba(255,255,255,.06), inset 1px 2px 2px -1px rgba(255,255,255,.12), 0 0 0 .5px rgba(0,0,0,.55), 0 1px 2px rgba(0,0,0,.3), 0 5px 12px -4px rgba(0,0,0,.3);\n    --mu-well: inset 0 2px 6px -1px rgba(0,0,0,.6), inset 0 0 0 .5px rgba(0,0,0,.35), inset 0 -2px 4px -2px rgba(255,255,255,.05);\n    --mu-cap-bg: linear-gradient(#35353A,#2A2A2D);\n    --mu-cap-sh: inset 0 0 3px 1px rgba(255,255,255,.06), 0 0 0 .5px rgba(0,0,0,.6), 0 1px 2px rgba(0,0,0,.3);\n    --mu-btn-bg: linear-gradient(#313134,#28282B);\n    --mu-btn-sh: inset 0 0 4px 1px rgba(255,255,255,.05), inset 1px 2px 2px -1px rgba(255,255,255,.10), 0 0 0 .5px rgba(0,0,0,.6), 0 1px 2px rgba(0,0,0,.3), 0 4px 9px -3px rgba(0,0,0,.3);\n    --mu-pressed-bg: linear-gradient(#18181A,#1C1C1E);\n    --mu-pressed-sh: inset 0 2px 5px -1px rgba(0,0,0,.65), inset 0 0 0 .5px rgba(0,0,0,.5), inset 0 -2px 3px -2px rgba(255,255,255,.05);\n    --mu-duo-k: 1.3;\n  }\n}\n"
