  "swap": {
    "$description": "Content swap (text, icon, count) inside a control: an overlapping crossfade, never a gap. Values reference the motion scale. The incoming layer is released two frames after mount (~33ms), which is the stagger; in-delay adds nothing on top.",
    "out": "var(--mu-duration-quick)",
    "in": "var(--mu-duration-fast)",
    "in-delay": "0ms",
    "shrink-delay": "var(--mu-duration-micro)",
    "travel": "var(--mu-distance-micro)",
    "blur": "var(--mu-blur-small)",
    "icon-scale": "var(--mu-scale-icon)",
    "icon": "var(--mu-duration-fast)"
  },
  "motion": {
    "$description": "The motion scale. Durations and eases are for tweens (opacity, blur, small travel); physical objects and footprints use the springs. Pick by usage, not by number. Scale follows transitions.dev; rules follow animations.dev and beUI.",
    "duration": {
      "stagger": {
        "value": "40ms",
        "use": "offset between items; the delay before an incoming swap"
      },
      "micro": {
        "value": "80ms",
        "use": "tooltip delay, shake segment, the wait before a footprint shrinks"
      },
      "quick": {
        "value": "150ms",
        "use": "outgoing content, closes, press, tooltip in"
      },
      "fast": {
        "value": "250ms",
        "use": "incoming content, icon swap, dropdown and modal open, sliding indicator"
      },
      "medium": {
        "value": "350ms",
        "use": "panel and toast close"
      },
      "slow": {
        "value": "400ms",
        "use": "panel open, skeleton reveal"
      },
      "gentle": {
        "value": "500ms",
        "use": "rare emphasis: text reveal, success"
      }
    },
    "ease": {
      "out": {
        "value": "cubic-bezier(0.22, 1, 0.36, 1)",
        "use": "default: anything entering, and small swaps"
      },
      "in-out": {
        "value": "cubic-bezier(0.645, 0.045, 0.355, 1)",
        "use": "things already on screen moving or crossfading out"
      },
      "linear": {
        "value": "linear",
        "use": "constant motion only: progress, spinners"
      }
    },
    "distance": {
      "micro": {
        "value": "4px",
        "use": "text swap"
      },
      "small": {
        "value": "6px",
        "use": "error shake"
      },
      "base": {
        "value": "8px",
        "use": "content swap in a panel, page step"
      },
      "medium": {
        "value": "12px",
        "use": "text reveal"
      }
    },
    "scale": {
      "icon": {
        "value": "0.25",
        "use": "icon swap"
      },
      "modal": {
        "value": "0.96",
        "use": "modal open and close"
      },
      "menu": {
        "value": "0.97",
        "use": "dropdown and popover open, from the trigger"
      },
      "tip": {
        "value": "0.98",
        "use": "tooltip open"
      }
    },
    "blur": {
      "small": {
        "value": "2px",
        "use": "text and icon swap, panel reveal, number change"
      },
      "medium": {
        "value": "3px",
        "use": "page step, text reveal"
      }
    }
  }
